<UserControl x:Class="StagePlayout.App.Controls.FadeBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ToolTip="Fade in / fade out — arrastar as pegas (0–5 s)">
    <Canvas x:Name="Root" Width="150" Height="14" Background="#1E1E1E" ClipToBounds="True">
        <Border x:Name="InFill" Height="14" Canvas.Left="0" Width="0" Background="#8063A0D8"/>
        <Border x:Name="OutFill" Height="14" Canvas.Left="0" Width="0" Background="#8063A0D8"/>
        <Thumb x:Name="InThumb" Width="7" Height="14" Canvas.Left="0"
               Cursor="SizeWE" DragDelta="InThumb_DragDelta"
               Background="{StaticResource AccentBrush}"/>
        <Thumb x:Name="OutThumb" Width="7" Height="14" Canvas.Left="0"
               Cursor="SizeWE" DragDelta="OutThumb_DragDelta"
               Background="{StaticResource AccentBrush}"/>
        <TextBlock x:Name="Lbl" Canvas.Top="0" FontSize="9" Foreground="#AAAAAA"
                   Width="150" TextAlignment="Center" IsHitTestVisible="False"
                   Text="in 0.5s · out 0.5s"/>
    </Canvas>
</UserControl>
