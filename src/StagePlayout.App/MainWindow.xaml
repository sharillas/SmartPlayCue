<Window x:Class="StagePlayout.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:controls="clr-namespace:StagePlayout.App.Controls"
        Title="Smart Play Cue" Height="680" Width="1320" MinHeight="480" MinWidth="1060"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Context menu for groups/playlists -->
        <ContextMenu x:Key="GroupMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Rename..." Click="RenameGroup_Click"/>
            <MenuItem Header="Repeat group (loop)" IsCheckable="True" IsChecked="{Binding LoopGroup}"/>
            <MenuItem Header="Expand / collapse" Click="GroupToggleExpand_Click"/>
            <Separator/>
            <MenuItem Header="Ungroup (keep clips)" Click="UngroupCue_Click"/>
            <MenuItem Header="Remove group (keep clips)" Click="RemoveCue_Click"/>
        </ContextMenu>

        <!-- Context menu for cue (loop / auto-continue / remove) -->
        <ContextMenu x:Key="CueMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="On End">
                <MenuItem Header="Hold last frame" IsCheckable="True"
                          IsChecked="{Binding End, Converter={StaticResource EqualsConverter}, ConverterParameter=HoldLastFrame}"/>
                <MenuItem Header="Stop (fade out)" IsCheckable="True"
                          IsChecked="{Binding End, Converter={StaticResource EqualsConverter}, ConverterParameter=Stop}"/>
                <MenuItem Header="Loop" IsCheckable="True"
                          IsChecked="{Binding End, Converter={StaticResource EqualsConverter}, ConverterParameter=Loop}"/>
                <MenuItem Header="Jump to cue" SubmenuOpened="JumpToCue_SubmenuOpened">
                    <MenuItem Header="(loading...)"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Fade In">
                <MenuItem Header="No fade" IsCheckable="True" IsChecked="{Binding FadeInSeconds, Converter={StaticResource EqualsConverter}, ConverterParameter=0}"/>
                <MenuItem Header="0.5 s" IsCheckable="True" IsChecked="{Binding FadeInSeconds, Converter={StaticResource EqualsConverter}, ConverterParameter=0.5}"/>
                <MenuItem Header="1 s" IsCheckable="True" IsChecked="{Binding FadeInSeconds, Converter={StaticResource EqualsConverter}, ConverterParameter=1}"/>
                <MenuItem Header="2 s" IsCheckable="True" IsChecked="{Binding FadeInSeconds, Converter={StaticResource EqualsConverter}, ConverterParameter=2}"/>
                <MenuItem Header="3 s" IsCheckable="True" IsChecked="{Binding FadeInSeconds, Converter={StaticResource EqualsConverter}, ConverterParameter=3}"/>
                <MenuItem Header="5 s" IsCheckable="True" IsChecked="{Binding FadeInSeconds, Converter={StaticResource EqualsConverter}, ConverterParameter=5}"/>
            </MenuItem>
            <MenuItem Header="Fade Out">
                <MenuItem Header="No fade" IsCheckable="True" IsChecked="{Binding FadeOutSeconds, Converter={StaticResource EqualsConverter}, ConverterParameter=0}"/>
                <MenuItem Header="0.5 s" IsCheckable="True" IsChecked="{Binding FadeOutSeconds, Converter={StaticResource EqualsConverter}, ConverterParameter=0.5}"/>
                <MenuItem Header="1 s" IsCheckable="True" IsChecked="{Binding FadeOutSeconds, Converter={StaticResource EqualsConverter}, ConverterParameter=1}"/>
                <MenuItem Header="2 s" IsCheckable="True" IsChecked="{Binding FadeOutSeconds, Converter={StaticResource EqualsConverter}, ConverterParameter=2}"/>
                <MenuItem Header="3 s" IsCheckable="True" IsChecked="{Binding FadeOutSeconds, Converter={StaticResource EqualsConverter}, ConverterParameter=3}"/>
                <MenuItem Header="5 s" IsCheckable="True" IsChecked="{Binding FadeOutSeconds, Converter={StaticResource EqualsConverter}, ConverterParameter=5}"/>
            </MenuItem>
            <MenuItem Header="Fade Type">
                <MenuItem Header="Cross (dissolve)" IsCheckable="True"
                          IsChecked="{Binding FadeType, Converter={StaticResource EqualsConverter}, ConverterParameter=Cross}"/>
                <MenuItem Header="Dip (through black)" IsCheckable="True"
                          IsChecked="{Binding FadeType, Converter={StaticResource EqualsConverter}, ConverterParameter=Dip}"/>
            </MenuItem>
            <MenuItem Header="Volume">
                <MenuItem Header="100%" IsCheckable="True" IsChecked="{Binding Volume, Converter={StaticResource EqualsConverter}, ConverterParameter=1}"/>
                <MenuItem Header="75%" IsCheckable="True" IsChecked="{Binding Volume, Converter={StaticResource EqualsConverter}, ConverterParameter=0.75}"/>
                <MenuItem Header="50%" IsCheckable="True" IsChecked="{Binding Volume, Converter={StaticResource EqualsConverter}, ConverterParameter=0.5}"/>
                <MenuItem Header="25%" IsCheckable="True" IsChecked="{Binding Volume, Converter={StaticResource EqualsConverter}, ConverterParameter=0.25}"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Group to playlist" Click="GroupSelection_Click"/>
            <MenuItem Header="Remove cue" Click="RemoveCue_Click"/>
        </ContextMenu>

        <Style x:Key="CueItemStyle" TargetType="ListBoxItem"
               BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="ContextMenu" Value="{StaticResource CueMenu}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter Property="ContextMenu" Value="{StaticResource GroupMenu}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Show mode: sem context menus (trava edições acidentais em live) -->
        <Style x:Key="CueItemStyleLocked" TargetType="ListBoxItem"
               BasedOn="{StaticResource {x:Type ListBoxItem}}"/>

        <!-- Modern Volume Slider -->
        <Style x:Key="VolumeSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Track x:Name="PART_Track" Grid.ColumnSpan="2" VerticalAlignment="Center" Height="4">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{StaticResource AccentBrush}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#404040" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#d0d0d0"
                                                         Width="14" Height="14"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark theme ToolTip -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource BgElevatedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Top bar ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/logo-144.png"
                       RenderOptions.BitmapScalingMode="Fant"
                       RenderOptions.EdgeMode="Aliased"
                       Height="36" Width="36" Margin="0,0,8,0" Stretch="Uniform"/>
                <StackPanel>
                    <TextBlock Text="Smart PlayCue" FontSize="27" FontWeight="SemiBold"
                               FontFamily="Segoe UI"/>
                    <TextBlock Text="powered by smartchoice" FontSize="9"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Timecode grande: tempo restante do clip no ar (fundo negro, dígitos largos) -->
            <Viewbox Grid.Column="1" Stretch="Uniform" MaxWidth="420" Margin="10,0">
                <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                        Padding="30,2" CornerRadius="8"
                        Background="Black"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text=" Remaining Time: " FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock x:Name="TxtBigRemaining" Text="--:--:--"
                                       FontFamily="Consolas" FontSize="38"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Viewbox>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnOpenProject" Content=" Open Project "
                        Margin="0,0,8,0" Click="BtnOpenProject_Click"/>
                <Button x:Name="BtnSaveProject" Content=" Save Project "
                        Margin="0,0,8,0" Click="BtnSaveProject_Click"/>
                <Button x:Name="BtnAddMedia" Content=" Add Media "
                        Margin="0,0,8,0" Click="BtnAddMedia_Click"/>
                <Button x:Name="BtnOutput" Content=" External Display ON " Click="BtnOutput_Click"
                        MouseRightButtonDown="BtnOutput_RightClick"
                        ToolTip="Abrir/fechar o output&#x0a;Right-click: ecrã de saída + refresh (preset do projeto)"/>
                <ToggleButton x:Name="BtnShowMode" Content="SHOW MODE" Margin="8,0,0,0"
                              Checked="BtnShowMode_Toggled" Unchecked="BtnShowMode_Toggled"
                              ToolTip="Modo show (Ctrl+L): trava edições acidentais —&#x0a;sem context menus, drag ou adicionar media" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- ===== Zona central: playlist + monitor PROGRAM ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" x:Name="CueList" SelectionMode="Extended"
                     ItemContainerStyle="{StaticResource CueItemStyle}"
                     AllowDrop="True" Drop="CueList_Drop"
                     DragEnter="CueList_DragOver" DragOver="CueList_DragOver" DragLeave="CueList_DragLeave"
                     PreviewMouseLeftButtonDown="CueList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="CueList_PreviewMouseMove"
                     MouseDoubleClick="CueList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <!-- Linha de GRUPO/playlist (cabeçalho expansível) -->
                            <StackPanel x:Name="GroupRow" Orientation="Horizontal"
                                        Visibility="Collapsed" Cursor="Hand"
                                        MouseLeftButtonDown="GroupRow_Click">
                                <TextBlock Text="{Binding ExpandGlyph}" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ChildCount, StringFormat='  ({0} clips)'}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Linha de CUE normal -->
                            <Grid x:Name="CueRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Border Background="{Binding TagColor}" Width="6" CornerRadius="2,0,0,2"
                                            Cursor="Hand" ToolTip="Right-click to change tag color"
                                            MouseRightButtonDown="TagColor_RightClick" Tag="{Binding}"/>

                                    <TextBlock Text="{Binding DisplayId}" Foreground="#888"
                                               FontSize="10" VerticalAlignment="Center" Margin="6,0,6,0"
                                               MinWidth="18" TextAlignment="Center"/>

                                    <Border Width="62" Height="40" CornerRadius="4"
                                            Background="{StaticResource BgElevatedBrush}"
                                            Margin="0,0,10,0">
                                        <Border.Clip>
                                            <RectangleGeometry Rect="0,0,62,40" RadiusX="4" RadiusY="4"/>
                                        </Border.Clip>
                                        <Image Source="{Binding Thumbnail, IsAsync=True}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding InfoText}" FontSize="11" Margin="0,1,0,0"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar Value="{Binding Progress}" Margin="0,4,0,0"
                                                Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"/>
                                    <controls:FadeBar Margin="0,4,0,0"
                                                      IsEnabled="{Binding EditLocked, Converter={StaticResource InverseBool}}"
                                                      FadeInSeconds="{Binding FadeInSeconds, Mode=TwoWay}"
                                                      FadeOutSeconds="{Binding FadeOutSeconds, Mode=TwoWay}">
                                        <controls:FadeBar.Style>
                                            <Style TargetType="controls:FadeBar">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:FadeBar.Style>
                                    </controls:FadeBar>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding TimeText}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>

                                <!-- Config indicators -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <Border Background="#333" CornerRadius="5" Width="46" Height="26" Cursor="Hand"
                                            ToolTip="Output da cue — right-click para escolher o ecrã"
                                            MouseRightButtonDown="OutputBadge_RightClick" Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="OUT " FontSize="10" Foreground="#888"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding OutputText}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#FF9800" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <svgc:SvgViewbox Source="pack://application:,,,/Assets/Icons/tabler-player-skip-forward.svg"
                                                     Width="14" Height="14" Margin="6,0,4,0"
                                                     Visibility="{Binding ShowHoldIcon, Converter={StaticResource BoolToVis}}"
                                                     ToolTip="Hold last frame"/>
                                    <svgc:SvgViewbox Source="pack://application:,,,/Assets/Icons/tabler-trending-down-2.svg"
                                                     Width="14" Height="14" Margin="0,0,4,0"
                                                     Visibility="{Binding ShowStopIcon, Converter={StaticResource BoolToVis}}"
                                                     ToolTip="Stop on end"/>
                                    <svgc:SvgViewbox Source="pack://application:,,,/Assets/Icons/tabler-reload.svg"
                                                     Width="14" Height="14" Margin="0,0,4,0"
                                                     Visibility="{Binding ShowLoopIcon, Converter={StaticResource BoolToVis}}"
                                                     ToolTip="Loop"/>
                                    <svgc:SvgViewbox Source="pack://application:,,,/Assets/Icons/tabler-corner-right-up-double.svg"
                                                     Width="14" Height="14" Margin="0,0,2,0"
                                                     Visibility="{Binding ShowJumpIcon, Converter={StaticResource BoolToVis}}"
                                                     ToolTip="Jump to next cue"/>
                                    <TextBlock Text="{Binding JumpTargetText}" FontSize="10" Foreground="#FF9800"
                                               VerticalAlignment="Center" FontWeight="SemiBold"
                                               Visibility="{Binding ShowJumpIcon, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding Volume, StringFormat='V {0:0%}'}" FontSize="10"
                                               Foreground="#888" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Volume}" Value="1.0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Inline action buttons -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Border Width="28" Height="26" CornerRadius="5" Background="#802E7D32"
                                            Cursor="Hand" ToolTip="Play">
                                        <Button Width="28" Height="26" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                Click="InlinePlay_Click" Tag="{Binding}">
                                            <svgc:SvgViewbox Source="pack://application:,,,/Assets/Icons/fa-audio-play.svg"
                                                             Width="13" Height="13"/>
                                        </Button>
                                    </Border>
                                    <Border Width="28" Height="26" CornerRadius="5" Background="#80C62828"
                                            Margin="2,0" Cursor="Hand" ToolTip="Stop">
                                        <Button Width="28" Height="26" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                Click="InlineStop_Click" Tag="{Binding}">
                                            <svgc:SvgViewbox Source="pack://application:,,,/Assets/Icons/fa-audio-stop.svg"
                                                             Width="13" Height="13"/>
                                        </Button>
                                    </Border>
                                    <Border Width="28" Height="26" CornerRadius="5" Background="#80E65100"
                                            Cursor="Hand" ToolTip="Pause">
                                        <Button Width="28" Height="26" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                Click="InlinePause_Click" Tag="{Binding}">
                                            <svgc:SvgViewbox Source="pack://application:,,,/Assets/Icons/fa-audio-pause.svg"
                                                             Width="13" Height="13"/>
                                        </Button>
                                    </Border>
                                    <Border Width="28" Height="26" CornerRadius="5" Background="#801565C0"
                                            Margin="2,0,0,0" Cursor="Hand" ToolTip="Rewind">
                                        <Button Width="28" Height="26" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                Click="InlineRewind_Click" Tag="{Binding}">
                                            <svgc:SvgViewbox Source="pack://application:,,,/Assets/Icons/fa-audio-backward.svg"
                                                             Width="13" Height="13"/>
                                        </Button>
                                    </Border>
                                    <Border Width="28" Height="26" CornerRadius="5" Background="#80333333"
                                            Margin="2,0,0,0" Cursor="Hand"
                                            ToolTip="Rotation: 0°/90°/180°/270°">
                                        <Button Width="28" Height="26" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                Click="InlineRotation_Click" Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <svgc:SvgViewbox Source="pack://application:,,,/Assets/Icons/rotation.svg"
                                                                 Width="13" Height="13"/>
                                                <TextBlock Text="{Binding RotationText}" FontSize="8"
                                                           Foreground="#FF9800" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                    <Border Width="28" Height="26" CornerRadius="5" Background="#80333333"
                                            Margin="2,0,0,0" Cursor="Hand" ToolTip="Mute/Unmute&#x0a;Right-click: audio device">
                                        <Button Width="28" Height="26" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                Content="{Binding MuteIcon}" FontSize="11"
                                                Foreground="White"
                                                Click="InlineMute_Click"
                                                MouseRightButtonDown="AudioOutput_RightClick" Tag="{Binding}"/>
                                    </Border>
                                    <Border Width="28" Height="26" CornerRadius="5" Background="#80333333"
                                            Margin="2,0,0,0" Cursor="Hand"
                                            ToolTip="Fill mode&#x0a;Click to toggle&#x0a;⊞ Fill | ⊡ Uniform">
                                        <Button Width="28" Height="26" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                Click="InlineFillMode_Click" Tag="{Binding}">
                                            <svgc:SvgViewbox x:Name="FillModeFitIcon"
                                                             Source="pack://application:,,,/Assets/Icons/fit-screen.svg"
                                                             Width="13" Height="13"/>
                                        </Button>
                                    </Border>
                                    <!-- Audio VU meter (L+R) -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0"
                                                Visibility="{Binding ShowAudioMeter, Converter={StaticResource BoolToVis}}">
                                        <Border Width="6" Height="16" CornerRadius="2" Background="#333"
                                                VerticalAlignment="Center" Margin="0,0,3,0">
                                            <Border Height="{Binding AudioPeakL}" VerticalAlignment="Bottom"
                                                    CornerRadius="2" Background="#4CAF50" MinHeight="2"/>
                                        </Border>
                                        <Border Width="6" Height="16" CornerRadius="2" Background="#333">
                                            <Border Height="{Binding AudioPeakR}" VerticalAlignment="Bottom"
                                                    CornerRadius="2" Background="#4CAF50" MinHeight="2"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                <Setter TargetName="GroupRow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CueRow" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChild}" Value="True">
                                <Setter TargetName="CueRow" Property="Margin" Value="22,0,0,0"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Coluna direita: PROGRAM + A SEGUIR + layers -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="12,0,0,0">
            <StackPanel Width="300">
                <TextBlock Text="PROGRAM" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,6"/>
                <Border Width="300" Height="169" CornerRadius="6" Background="Black"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,300,169" RadiusX="6" RadiusY="6"/>
                    </Border.Clip>
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                </Border>

                <TextBlock Text="A SEGUIR" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="2,12,0,6"/>
                <Border Width="300" Height="169" CornerRadius="6" Background="Black"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,300,169" RadiusX="6" RadiusY="6"/>
                    </Border.Clip>
                    <Image x:Name="NextThumb" Stretch="UniformToFill"/>
                </Border>
                <TextBlock x:Name="TxtNextCue" Text="—" Margin="2,6,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtNextOut" Text="OUT AUTO (preset)" FontSize="10"
                           Foreground="#FF9800" Margin="2,4,0,0"/>

                <!-- Composição com layers (alpha real no compositor GPU) -->
                <TextBlock Text="COMPOSIÇÃO COM LAYERS" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="2,18,0,6"/>
                <Border Padding="10" CornerRadius="8"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>

                        <!-- editor visual de geometria: arrasta = move, canto = redimensiona -->
                        <Canvas x:Name="GeomCanvas" Width="276" Height="155" Margin="0,0,0,0"
                                Background="Black" ClipToBounds="True">
                            <Border x:Name="GeomRect" BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="2" Background="#333B82F6">
                                <Grid>
                                    <Thumb x:Name="GeomMoveThumb" Background="Transparent"
                                           DragDelta="GeomMove_DragDelta"/>
                                    <Thumb x:Name="GeomResizeThumb" Width="14" Height="14"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Background="{StaticResource AccentBrush}"
                                           DragDelta="GeomResize_DragDelta"/>
                                </Grid>
                            </Border>
                        </Canvas>

                        <!-- lista dinâmica de layers (até 4) -->
                        <ItemsControl x:Name="LayerList" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <RadioButton GroupName="LayerSel" VerticalAlignment="Center"
                                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                         Click="LayerSelect_Click" Tag="{Binding}">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                            </RadioButton>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Margin="6,0,6,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Content="Vídeo…" Tag="{Binding}" Padding="6,3"
                                                        FontSize="11" Click="LayerOpen_Click"/>
                                                <Button Content="{Binding ToggleText}" Tag="{Binding}" Padding="6,3"
                                                        FontSize="11" Margin="3,0,0,0" IsEnabled="{Binding HasFile}"
                                                        Click="LayerToggle_Click"/>
                                                <ToggleButton Content="SOM" Tag="{Binding}" Padding="6,3"
                                                              FontSize="11" Margin="3,0,0,0"
                                                              IsChecked="{Binding SoundOn, Mode=OneWay}"
                                                              Click="LayerMute_Click"
                                                              ToolTip="Som da layer (off = muda)"/>
                                                <Button Content="{Binding BlendText}" Tag="{Binding}" Padding="6,3"
                                                        FontSize="11" Margin="3,0,0,0" Click="LayerBlend_Click"
                                                        ToolTip="Blend mode: alpha normal ou aditivo (Add)"/>
                                                <Button Content="✕" Tag="{Binding}" Padding="4,3"
                                                        FontSize="11" Margin="3,0,0,0" Click="RemoveLayer_Click"
                                                        ToolTip="Remover layer"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button x:Name="BtnAddLayer" Content="＋ ADICIONAR LAYER" Padding="8,4" FontSize="11"
                                Margin="0,10,0,0" Click="AddLayer_Click"
                                ToolTip="Adicionar layer (máx. 4)"/>

                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Transporte ===== -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" CornerRadius="8"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnGo" Content="GO"
                            Style="{StaticResource GoButtonStyle}" Click="BtnGo_Click"/>
                    <Button Grid.Column="1" x:Name="BtnPause" Content="PAUSE"
                            Margin="10,0,0,0" Click="BtnPause_Click" IsEnabled="False"/>
                    <Button Grid.Column="2" x:Name="BtnStop" Content="STOP"
                            Margin="6,0,0,0" Click="BtnStop_Click" IsEnabled="False"/>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock x:Name="TxtNowPlaying" Text="No cue loaded"
                                   FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtTime" Text="--:--:-- / --:--:--"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="BtnOverlay" Content="OVL" Width="42" Height="24"
                                      FontSize="11" Padding="0" Margin="0,0,6,0" IsChecked="True"
                                      Checked="Overlay_Toggled" Unchecked="Overlay_Toggled"
                                      ToolTip="Overlay de confiança no ecrã de palco (cue + tempo restante)"/>
                        <Button x:Name="BtnMasterMute" Content="&#x1F50A;"
                                Width="28" Height="24" FontSize="13" Padding="0"
                                Background="Transparent" Foreground="{StaticResource TextMutedBrush}"
                                BorderThickness="0" Cursor="Hand"
                                Click="MasterMute_Click"
                                MouseRightButtonDown="MasterAudioDevice_RightClick"
                                ToolTip="Master mute&#x0a;Right-click: audio device"/>
                        <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="100"
                                Value="100" VerticalAlignment="Center" Margin="6,0"
                                Style="{StaticResource VolumeSliderStyle}"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="TxtVolume" Text="100%" Width="34" TextAlignment="Right"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <TextBlock Grid.Row="3" x:Name="TxtStatus" Margin="2,10,2,0"
                   Foreground="{StaticResource TextMutedBrush}" Text="READY"/>

        <!-- ===== Footer ===== -->
        <TextBlock Grid.Row="4" x:Name="TxtFooter" HorizontalAlignment="Right" Margin="0,6,0,0"
                   FontSize="10" Foreground="#999999"
                   Text="Copyright © 2026 Nelson Teixeira · SmartChoice — All Rights Reserved"/>
    </Grid>
</Window>
