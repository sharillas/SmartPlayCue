<Window x:Class="StagePlayout.App.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renomear" Width="380" SizeToContent="Height"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock x:Name="TxtTitle" Text="Nome" FontWeight="SemiBold"/>
        <TextBox x:Name="Box" Margin="0,10,0,14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="OK" IsDefault="True" Click="Ok_Click" Padding="20,0"/>
        </StackPanel>
    </StackPanel>
</Window>
