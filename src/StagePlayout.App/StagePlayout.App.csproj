<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\StagePlayout.Core\StagePlayout.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>2.6.4</Version>
    <Product>Smart Play Cue</Product>
    <AssemblyName>SmartPlayCue</AssemblyName>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms only for multi-screen detection; avoid namespace ambiguity -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- FFmpeg nativo v8 -> copiado para output\FFmpeg -->
    <None Include="..\..\thirdparty\FFmpeg\*" Link="FFmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Garante que o publish coloca as DLLs dentro de FFmpeg\ (o Link perde-se no single-file) -->
  <Target Name="CopyFFmpegToPublish" AfterTargets="Publish">
    <ItemGroup>
      <FFmpegPublishFiles Include="..\..\thirdparty\FFmpeg\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FFmpegPublishFiles)"
          DestinationFiles="@(FFmpegPublishFiles->'$(PublishDir)FFmpeg\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Resource Include="Assets\logo.svg" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo-144.png" />
    <Resource Include="Assets\Icons\fa-audio-play.svg" />
    <Resource Include="Assets\Icons\fa-audio-stop.svg" />
    <Resource Include="Assets\Icons\fa-audio-pause.svg" />
    <Resource Include="Assets\Icons\fa-audio-backward.svg" />
    <Resource Include="Assets\Icons\tabler-player-stop.svg" />
    <Resource Include="Assets\Icons\tabler-repeat.svg" />
    <Resource Include="Assets\Icons\tabler-arrow-forward-up.svg" />
    <Resource Include="Assets\Icons\tabler-player-pause.svg" />
    <Resource Include="Assets\Icons\tabler-player-skip-forward.svg" />
    <Resource Include="Assets\Icons\tabler-reload.svg" />
    <Resource Include="Assets\Icons\tabler-device-ipad-horizontal-share.svg" />
    <Resource Include="Assets\Icons\tabler-corner-right-up-double.svg" />
    <Resource Include="Assets\Icons\tabler-trending-down-2.svg" />
    <Resource Include="Assets\app-icon.svg" />
    <Resource Include="Assets\Fonts\BebasNeue-Regular.ttf" />
    <Resource Include="Assets\Fonts\Megrim.ttf" />
    <Resource Include="Assets\Icons\fit-screen.svg" />
    <Resource Include="Assets\Icons\aspect-ratio.svg" />
    <Resource Include="Assets\Icons\rotation.svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Flyleaf.FFmpeg.Bindings" Version="8.1.0" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="SharpVectors" Version="1.8.5" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.7.6-beta" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.7.6-beta" />
    <PackageReference Include="Vortice.DXGI" Version="3.7.6-beta" />
    <PackageReference Include="Vortice.Mathematics" Version="1.9.3" />
  </ItemGroup>

</Project>

